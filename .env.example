# OiU Environment Configuration Template
# Copy this file to .env for local server development.
# NEVER commit your real .env file or API keys to git!

# Optional: Google Gemini API Key for server-side AI generation (if running @oiu/server)
# Note: For the Chrome Extension, enter your free key directly in the Sidepanel UI
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=8080

